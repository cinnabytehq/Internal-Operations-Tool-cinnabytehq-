---
import Skeleton from '@/components/ui/Skeleton.astro';
---

<div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4" role="status" aria-busy="true">
  <span class="sr-only">Loading metrics…</span>
  {
    Array.from({ length: 4 }, () => (
      <div class="rounded-card border border-line bg-surface p-4 shadow-card sm:p-5">
        <div class="flex items-center justify-between">
          <Skeleton class="h-3.5 w-24" />
          <Skeleton class="size-7" />
        </div>
        <Skeleton class="mt-3 h-7 w-12" />
        <Skeleton class="mt-2.5 h-3 w-28" />
      </div>
    ))
  }
</div>
