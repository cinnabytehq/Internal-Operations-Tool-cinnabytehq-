---
/**
 * KPI row (server island). Each tile links to the matching request view.
 */
import Inbox from '@lucide/astro/icons/inbox';
import Loader from '@lucide/astro/icons/loader';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import CircleCheckBig from '@lucide/astro/icons/circle-check-big';
import ErrorState from '@/components/ui/ErrorState.astro';
import { getDashboardSummary } from '@/services/dashboard';
import type { DashboardSummary } from '@/types';

let summary: DashboardSummary | null = null;
try {
  summary = await getDashboardSummary();
} catch {
  summary = null;
}

const tiles = summary
  ? [
      {
        label: 'Active requests',
        value: summary.activeRequests.count,
        icon: Inbox,
        href: '/requests',
        emphasis: summary.activeRequests.openedThisWeek > 0 ? `+${summary.activeRequests.openedThisWeek}` : '0',
        context: 'opened this week',
        attention: false,
      },
      {
        label: 'In progress',
        value: summary.inProgress.count,
        icon: Loader,
        href: '/requests?view=in_progress',
        emphasis: String(summary.inProgress.highPriority),
        context: 'high priority',
        attention: false,
      },
      {
        label: 'Awaiting approval',
        value: summary.awaitingApproval.count,
        icon: ShieldCheck,
        href: '/requests?view=pending_approval',
        emphasis: String(summary.awaitingApproval.waitingOnYou),
        context: 'waiting on you',
        attention: summary.awaitingApproval.waitingOnYou > 0,
      },
      {
        label: 'Completed',
        value: summary.completed.count,
        icon: CircleCheckBig,
        href: '/requests?view=completed',
        emphasis: String(summary.completed.lastSevenDays),
        context: 'in the last 7 days',
        attention: false,
      },
    ]
  : [];
---

{
  summary ? (
    <div class="grid animate-fade-in grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-4">
      {tiles.map(({ icon: Icon, ...tile }) => (
        <a
          href={tile.href}
          class="group flex flex-col rounded-card border border-line bg-surface p-4 shadow-card transition-[border-color,background-color] duration-150 hover:border-line-strong sm:p-5"
        >
          <span class="flex items-center justify-between gap-2">
            <span class="text-[13px] font-medium text-fg-muted">{tile.label}</span>
            <span class="flex size-7 items-center justify-center rounded-md bg-subtle text-fg-subtle transition-colors group-hover:text-accent-ink">
              <Icon class="size-3.5" aria-hidden="true" />
            </span>
          </span>
          <span class="mt-3 text-[28px] leading-none font-semibold tracking-tight text-fg">{tile.value}</span>
          <span class="mt-2.5 flex items-center gap-1.5 text-xs text-fg-muted">
            {tile.attention && <span class="size-1.5 shrink-0 rounded-full bg-warning-ink" aria-hidden="true" />}
            <span>
              <span class="font-medium text-fg">{tile.emphasis}</span> {tile.context}
            </span>
          </span>
        </a>
      ))}
    </div>
  ) : (
    <div class="rounded-card border border-line bg-surface">
      <ErrorState compact description="We couldn't load your workspace metrics." />
    </div>
  )
}
