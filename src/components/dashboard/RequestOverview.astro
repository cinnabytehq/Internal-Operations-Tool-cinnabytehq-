---
/**
 * Request overview (server island): how requests are spread across the
 * workflow, plus the few that need attention right now.
 */
import Avatar from '@/components/ui/Avatar.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import ErrorState from '@/components/ui/ErrorState.astro';
import PipelineIcon from '@/components/ui/PipelineIcon.astro';
import { getDashboardSummary } from '@/services/dashboard';
import { getRequests } from '@/services/requests';
import { formatRelative } from '@/lib/dates';
import { REQUEST_STATUS_META } from '@/lib/meta';
import { cn, percent, pluralize } from '@/lib/utils';
import type { RequestStatus, RequestWithRelations } from '@/types';

let data: Awaited<ReturnType<typeof load>> | null = null;
async function load() {
  const [summary, requests] = await Promise.all([getDashboardSummary(), getRequests()]);
  return { summary, requests };
}
try {
  data = await load();
} catch {
  data = null;
}

const fills: Record<RequestStatus, string> = {
  new: 'bg-status-new',
  in_review: 'bg-status-review',
  in_progress: 'bg-status-progress',
  completed: 'bg-status-done',
};
const icons: Record<RequestStatus, string> = {
  new: 'text-status-new',
  in_review: 'text-status-review',
  in_progress: 'text-status-progress',
  completed: 'text-status-done',
};

/** Why a request is in "Needs attention" (first matching reason wins). */
function attentionReason(request: RequestWithRelations): string | null {
  if (request.status === 'completed') return null;
  if (request.approval?.status === 'pending') return `Awaiting ${request.approval.approver.name.split(' ')[0]}`;
  if (!request.assignee) return 'Unassigned';
  if (request.priority === 'high') return 'High priority';
  if (request.status === 'new') return 'Needs triage';
  return null;
}

const attention = (data?.requests ?? [])
  .map((request) => ({ request, reason: attentionReason(request) }))
  .filter((item): item is { request: RequestWithRelations; reason: string } => item.reason !== null)
  .slice(0, 4);
const total = data?.summary.total ?? 0;
const open = data ? total - (data.summary.statusBreakdown.find((item) => item.status === 'completed')?.count ?? 0) : 0;
---

{
  !data ? (
    <ErrorState compact description="We couldn't load the request overview." />
  ) : total === 0 ? (
    <EmptyState
      compact
      title="No requests yet"
      description="When your team submits an internal request, it will appear here."
    />
  ) : (
    <div class="animate-fade-in">
      <p class="-mt-2 mb-4 text-[13px] text-fg-muted">
        <span class="font-medium text-fg">{open} open</span> of {pluralize(total, 'request')}
      </p>

      {/* Part-to-whole bar: 2px surface gaps, rounded data ends */}
      <div class="flex h-2.5 gap-0.5" role="img" aria-label={data.summary.statusBreakdown.map((item) => `${REQUEST_STATUS_META[item.status].label}: ${item.count}`).join(', ')}>
        {data.summary.statusBreakdown
          .filter((item) => item.count > 0)
          .map((item) => (
            <div
              class={cn('group relative h-full rounded-[3px] first:rounded-l-full last:rounded-r-full', fills[item.status])}
              style={`width: ${(item.count / total) * 100}%`}
            >
              <span class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 rounded-md bg-fg px-2 py-1 text-xs font-medium whitespace-nowrap text-fg-inverse opacity-0 shadow-pop transition-opacity duration-150 group-hover:opacity-100">
                {REQUEST_STATUS_META[item.status].label} · {item.count} ({percent(item.count, total)}%)
              </span>
            </div>
          ))}
      </div>

      {/* Legend doubles as the data table */}
      <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-4">
        {data.summary.statusBreakdown.map((item) => (
          <div>
            <dt class="flex items-center gap-1.5 text-xs text-fg-muted">
              <PipelineIcon step={REQUEST_STATUS_META[item.status].step} total={4} size={12} class={icons[item.status]} />
              {REQUEST_STATUS_META[item.status].label}
            </dt>
            <dd class="mt-1 flex items-baseline gap-1.5">
              <span class="text-xl font-semibold tracking-tight text-fg">{item.count}</span>
              <span class="tabular text-xs text-fg-subtle">{percent(item.count, total)}%</span>
            </dd>
          </div>
        ))}
      </dl>

      <div class="mt-5 border-t border-line pt-4">
        <h3 class="text-xs font-medium text-fg-muted">Needs attention</h3>
        {attention.length === 0 ? (
          <p class="py-4 text-[13px] text-fg-muted">Nothing is blocked. Nice work.</p>
        ) : (
          <ul class="-mx-2 mt-1.5">
            {attention.map(({ request, reason }) => (
              <li>
                <a
                  href={`/requests/${request.id}`}
                  class="flex items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-subtle"
                >
                  <PipelineIcon step={REQUEST_STATUS_META[request.status].step} total={4} class={icons[request.status]} />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[13px] font-medium text-fg">{request.title}</span>
                    <span class="mt-0.5 flex items-center gap-1.5 text-xs text-fg-subtle">
                      <span class="font-mono">{request.id}</span>
                      <span aria-hidden="true">·</span>
                      <span class={cn(reason === 'High priority' && 'text-danger-ink', reason.startsWith('Awaiting') && 'text-warning-ink')}>
                        {reason}
                      </span>
                    </span>
                  </span>
                  {request.assignee && <Avatar user={request.assignee} labelled />}
                  <span class="hidden w-14 text-right text-xs text-fg-subtle sm:block">{formatRelative(request.updatedAt)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  )
}
