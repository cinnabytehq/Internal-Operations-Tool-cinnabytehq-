---
/**
 * Request overview (server island) — from GET /api/dashboard: how requests
 * are spread across the workflow, plus the few that need attention now.
 */
import Avatar from '@/components/ui/Avatar.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import ErrorState from '@/components/ui/ErrorState.astro';
import RequestStatusIcon from '@/components/requests/RequestStatusIcon.astro';
import { serverApi } from '@/lib/api/server';
import { formatRelative } from '@/lib/dates';
import { REQUEST_STATUS_META, requestRef } from '@/lib/meta';
import { cn, percent, pluralize } from '@/lib/utils';
import type { DashboardSummary, RequestStatus } from '@/types';

let summary: DashboardSummary | null = null;
let loadError = '';
try {
  summary = await serverApi(Astro).getDashboard();
} catch (error) {
  loadError = error instanceof Error ? error.message : '';
}

const fills: Record<RequestStatus, string> = {
  new: 'bg-status-new',
  in_review: 'bg-status-review',
  in_progress: 'bg-status-progress',
  completed: 'bg-status-done',
  rejected: 'bg-status-rejected',
};

const total = summary?.total ?? 0;
const open = summary?.active_requests.count ?? 0;
// Only show "Rejected" in the legend when there is something to show.
const breakdown = summary?.status_breakdown.filter((item) => item.status !== 'rejected' || item.count > 0) ?? [];
---

{
  !summary ? (
    <ErrorState compact description={loadError || "We couldn't load the request overview."} />
  ) : total === 0 ? (
    <EmptyState compact title="No requests yet" description="When your team submits an internal request, it will appear here." />
  ) : (
    <div class="animate-fade-in">
      <p class="-mt-2 mb-4 text-[13px] text-fg-muted">
        <span class="font-medium text-fg">{open} open</span> of {pluralize(total, 'request')}
      </p>

      {/* Part-to-whole bar: 2px surface gaps, rounded data ends */}
      <div
        class="flex h-2.5 gap-0.5"
        role="img"
        aria-label={breakdown.map((item) => `${REQUEST_STATUS_META[item.status].label}: ${item.count}`).join(', ')}
      >
        {breakdown
          .filter((item) => item.count > 0)
          .map((item) => (
            <div
              class={cn('group relative h-full rounded-[3px] first:rounded-l-full last:rounded-r-full', fills[item.status])}
              style={`width: ${(item.count / total) * 100}%`}
            >
              <span class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 rounded-md bg-fg px-2 py-1 text-xs font-medium whitespace-nowrap text-fg-inverse opacity-0 shadow-pop transition-opacity duration-150 group-hover:opacity-100">
                {REQUEST_STATUS_META[item.status].label} · {item.count} ({percent(item.count, total)}%)
              </span>
            </div>
          ))}
      </div>

      {/* Legend doubles as the data table */}
      <dl class:list={['mt-4 grid grid-cols-2 gap-x-4 gap-y-4', breakdown.length > 4 ? 'sm:grid-cols-5' : 'sm:grid-cols-4']}>
        {breakdown.map((item) => (
          <div>
            <dt class="flex items-center gap-1.5 text-xs text-fg-muted">
              <RequestStatusIcon status={item.status} size={12} />
              {REQUEST_STATUS_META[item.status].label}
            </dt>
            <dd class="mt-1 flex items-baseline gap-1.5">
              <span class="text-xl font-semibold tracking-tight text-fg">{item.count}</span>
              <span class="tabular text-xs text-fg-subtle">{percent(item.count, total)}%</span>
            </dd>
          </div>
        ))}
      </dl>

      <div class="mt-5 border-t border-line pt-4">
        <h3 class="text-xs font-medium text-fg-muted">Needs attention</h3>
        {summary.needs_attention.length === 0 ? (
          <p class="py-4 text-[13px] text-fg-muted">Nothing is blocked. Nice work.</p>
        ) : (
          <ul class="-mx-2 mt-1.5">
            {summary.needs_attention.map(({ request, reason }) => (
              <li>
                <a href={`/requests/${request.id}`} class="flex items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-subtle">
                  <RequestStatusIcon status={request.status} />
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[13px] font-medium text-fg">{request.title}</span>
                    <span class="mt-0.5 flex items-center gap-1.5 text-xs text-fg-subtle">
                      <span class="font-mono">{requestRef(request.number)}</span>
                      <span aria-hidden="true">·</span>
                      <span class={cn(reason === 'High priority' && 'text-danger-ink', reason.startsWith('Awaiting') && 'text-warning-ink')}>
                        {reason}
                      </span>
                    </span>
                  </span>
                  {request.assignee && <Avatar user={request.assignee} labelled />}
                  <span class="hidden w-14 text-right text-xs text-fg-subtle sm:block">{formatRelative(request.updated_at)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  )
}
