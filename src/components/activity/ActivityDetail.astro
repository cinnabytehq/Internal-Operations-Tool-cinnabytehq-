---
/**
 * Secondary line under an activity sentence: status transitions, progress
 * changes, comments and approval notes.
 */
import type { ActivityWithRelations } from '@/types';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { statusLabel } from '@/lib/meta';
import { cn } from '@/lib/utils';

interface Props {
  event: ActivityWithRelations;
  /** Clamp long comments to two lines */
  clamp?: boolean;
  class?: string;
}

const { event, clamp = false, class: className } = Astro.props;
const { metadata } = event;
const showTransition = ['status_changed', 'approved', 'rejected', 'progress_updated'].includes(event.action);
const transition =
  showTransition && metadata.from && metadata.to
    ? event.action === 'progress_updated'
      ? { from: `${metadata.from}%`, to: `${metadata.to}%` }
      : { from: statusLabel(event.entity, metadata.from), to: statusLabel(event.entity, metadata.to) }
    : null;
const chip = 'inline-flex h-5 items-center rounded border border-line bg-subtle px-1.5 text-[11px] font-medium text-fg-muted';
---

{
  transition && (
    <p class={cn('mt-1.5 flex flex-wrap items-center gap-1.5', className)}>
      <span class={chip}>{transition.from}</span>
      <ArrowRight class="size-3 text-fg-subtle" aria-label="to" />
      <span class={cn(chip, 'text-fg')}>{transition.to}</span>
    </p>
  )
}
{
  metadata.comment && (
    <blockquote
      class={cn(
        'mt-1.5 rounded-md border border-line bg-subtle/70 px-3 py-2 text-[13px] leading-relaxed whitespace-pre-line text-fg',
        clamp && 'line-clamp-2',
        className,
      )}
    >
      {metadata.comment}
    </blockquote>
  )
}
