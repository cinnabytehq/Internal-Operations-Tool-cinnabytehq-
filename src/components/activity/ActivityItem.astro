---
/**
 * Compact activity row: avatar, sentence, detail and relative time.
 * Used on the dashboard, in notifications and on project pages.
 */
import type { ActivityWithActor } from '@/types';
import Avatar from '@/components/ui/Avatar.astro';
import { formatDateTime, formatRelative } from '@/lib/dates';
import ActivityDetail from './ActivityDetail.astro';
import ActivityText from './ActivityText.astro';

interface Props {
  event: ActivityWithActor;
  timeZone: string;
  showDetail?: boolean;
}

const { event, timeZone, showDetail = true } = Astro.props;
---

<div class="flex gap-3">
  <Avatar user={event.actor} size="md" class="mt-0.5" />
  <div class="min-w-0 flex-1">
    <ActivityText event={event} />
    {showDetail && <ActivityDetail event={event} clamp />}
    <time datetime={event.createdAt} title={formatDateTime(event.createdAt, timeZone)} class="mt-1 block text-xs text-fg-subtle">
      {formatRelative(event.createdAt)}
    </time>
  </div>
</div>
