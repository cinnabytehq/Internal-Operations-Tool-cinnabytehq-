---
/**
 * Workflow stepper: New → In review → In progress → Completed.
 * Shows where the request is, when each stage was reached and whether an
 * approval is holding it.
 */
import type { ActivityWithActor, RequestStatus, RequestWithRelations } from '@/types';
import Check from '@lucide/astro/icons/check';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import { formatDate } from '@/lib/dates';
import { REQUEST_STATUSES, REQUEST_STATUS_META } from '@/lib/meta';
import { cn } from '@/lib/utils';

interface Props {
  request: RequestWithRelations;
  timeline: ActivityWithActor[];
  timeZone: string;
}

const { request, timeline, timeZone } = Astro.props;
const currentStep = REQUEST_STATUS_META[request.status].step;

/** When did the request last enter each stage? */
function reachedAt(status: RequestStatus): string | null {
  if (status === 'new') return request.createdAt;
  const event = [...timeline].reverse().find((item) => item.type === 'status_changed' && item.meta?.to === status);
  return event?.createdAt ?? null;
}

const steps = REQUEST_STATUSES.map((status) => {
  const step = REQUEST_STATUS_META[status].step;
  const state = step < currentStep || request.status === 'completed' ? 'done' : step === currentStep ? 'current' : 'upcoming';
  let note: string | null = null;
  if (status === 'in_review' && request.approval) {
    note =
      request.approval.status === 'pending'
        ? `Awaiting ${request.approval.approver.name.split(' ')[0]}`
        : `Approved by ${request.approval.approver.name.split(' ')[0]}`;
  } else if (state !== 'upcoming') {
    const at = reachedAt(status);
    note = at ? formatDate(at, timeZone) : null;
  }
  return { status, label: REQUEST_STATUS_META[status].label, state, note, step };
});
---

<ol class="grid grid-cols-4" aria-label="Request workflow">
  {
    steps.map((step, index) => (
      <li class="relative flex flex-col items-center text-center" aria-current={step.state === 'current' ? 'step' : undefined}>
        {index > 0 && (
          <span
            aria-hidden="true"
            class={cn(
              'absolute top-3.5 right-1/2 h-0.5 w-full -translate-y-1/2',
              step.state === 'upcoming' ? 'bg-line' : 'bg-accent',
            )}
          />
        )}
        <span
          class={cn(
            'relative z-10 flex size-7 items-center justify-center rounded-full text-xs font-semibold ring-4 ring-surface',
            step.state === 'done' && 'bg-accent text-accent-fg',
            step.state === 'current' && 'border-2 border-accent bg-accent-soft text-accent-ink',
            step.state === 'upcoming' && 'border border-line-strong bg-surface text-fg-subtle',
          )}
        >
          {step.state === 'done' ? <Check class="size-3.5" stroke-width={3} aria-hidden="true" /> : step.step}
        </span>
        <span class={cn('mt-2 text-xs font-medium sm:text-[13px]', step.state === 'upcoming' ? 'text-fg-subtle' : 'text-fg')}>
          {step.label}
          <span class="sr-only">
            {step.state === 'done' ? ' (done)' : step.state === 'current' ? ' (current stage)' : ' (upcoming)'}
          </span>
        </span>
        {step.note && (
          <span
            class={cn(
              'mt-0.5 flex items-center gap-1 text-[11px] sm:text-xs',
              step.note.startsWith('Awaiting') ? 'text-warning-ink' : 'text-fg-subtle',
            )}
          >
            {step.status === 'in_review' && request.approval && <ShieldCheck class="size-3 max-sm:hidden" aria-hidden="true" />}
            {step.note}
          </span>
        )}
      </li>
    ))
  }
</ol>
