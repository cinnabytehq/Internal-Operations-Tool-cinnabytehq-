---
/**
 * The request list: a table on tablets/desktop, stacked cards on phones.
 * Rows carry data-filter-* attributes so the search box can filter
 * instantly on the client (src/scripts/listFilter.ts).
 */
import type { RequestWithRelations } from '@/types';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Avatar from '@/components/ui/Avatar.astro';
import CategoryIcon from './CategoryIcon.astro';
import PriorityLabel from './PriorityLabel.astro';
import RequestStatus from './RequestStatus.astro';
import { formatDateTime, formatRelative } from '@/lib/dates';
import { CATEGORY_META } from '@/lib/meta';
import { matchesQuery } from '@/lib/utils';
import { requestSearchText } from '@/services/requests';

interface Props {
  requests: RequestWithRelations[];
  query: string;
  timeZone: string;
}

const { requests, query, timeZone } = Astro.props;
const rows = requests.map((request) => {
  const text = requestSearchText(request);
  return { request, text, visible: matchesQuery(text, query) };
});
const th = 'px-3 py-2.5 text-left text-xs font-medium text-fg-subtle';
---

<!-- Tablet & desktop -->
<div class="hidden overflow-x-auto rounded-card border border-line bg-surface shadow-card md:block" data-filter-hide-when-empty hidden={!rows.some((row) => row.visible)}>
  <table class="w-full min-w-[860px] border-collapse text-[13px]">
    <caption class="sr-only">Requests</caption>
    <thead class="border-b border-line bg-subtle/60">
      <tr>
        <th scope="col" class:list={[th, 'pl-5']}>Request</th>
        <th scope="col" class={th}>Requester</th>
        <th scope="col" class={th}>Assignee</th>
        <th scope="col" class={th}>Priority</th>
        <th scope="col" class={th}>Status</th>
        <th scope="col" class:list={[th, 'pr-5 text-right']}>Updated</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ request, text, visible }) => (
          <tr
            data-filter-item
            data-filter-text={text}
            data-row-href={`/requests/${request.id}`}
            hidden={!visible}
            class="cursor-pointer border-b border-line transition-colors duration-100 last:border-0 hover:bg-subtle/70"
          >
            <td class="max-w-0 py-3 pr-3 pl-5">
              <div class="flex items-center gap-3">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-md border border-line bg-subtle text-fg-muted">
                  <CategoryIcon category={request.category} />
                </span>
                <div class="min-w-0">
                  <a href={`/requests/${request.id}`} class="block truncate font-medium text-fg hover:underline">
                    {request.title}
                  </a>
                  <p class="mt-0.5 truncate text-xs text-fg-subtle">
                    <span class="font-mono">{request.id}</span> · {CATEGORY_META[request.category].label}
                  </p>
                </div>
              </div>
            </td>
            <td class="w-44 px-3 py-3">
              <span class="flex items-center gap-2">
                <Avatar user={request.requester} />
                <span class="truncate text-fg">{request.requester.name}</span>
              </span>
            </td>
            <td class="w-48 px-3 py-3">
              {request.assignee ? (
                <span class="flex items-center gap-2">
                  <Avatar user={request.assignee} />
                  <span class="min-w-0">
                    <span class="block truncate text-fg">{request.assignee.name}</span>
                    <span class="block truncate text-xs text-fg-subtle">{request.assignee.team}</span>
                  </span>
                </span>
              ) : (
                <span class="text-fg-subtle">Unassigned</span>
              )}
            </td>
            <td class="w-28 px-3 py-3">
              <PriorityLabel priority={request.priority} />
            </td>
            <td class="w-40 px-3 py-3">
              <RequestStatus status={request.status} />
              {request.approval?.status === 'pending' && (
                <span class="mt-1 flex items-center gap-1 text-xs text-warning-ink">
                  <ShieldCheck class="size-3" aria-hidden="true" />
                  Awaiting approval
                </span>
              )}
            </td>
            <td class="w-28 py-3 pr-5 pl-3 text-right text-fg-muted">
              <time datetime={request.updatedAt} title={formatDateTime(request.updatedAt, timeZone)}>
                {formatRelative(request.updatedAt)}
              </time>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<!-- Phones -->
<ul class="flex flex-col gap-2.5 md:hidden" aria-label="Requests">
  {
    rows.map(({ request, text, visible }) => (
      <li data-filter-item data-filter-text={text} hidden={!visible}>
        <a
          href={`/requests/${request.id}`}
          class="block rounded-card border border-line bg-surface p-4 shadow-card transition-colors active:bg-subtle"
        >
          <span class="flex items-center justify-between gap-3">
            <span class="flex min-w-0 items-center gap-1.5 text-xs text-fg-subtle">
              <CategoryIcon category={request.category} />
              <span class="font-mono">{request.id}</span>
            </span>
            <RequestStatus status={request.status} />
          </span>
          <span class="mt-2 block text-sm leading-snug font-medium text-fg">{request.title}</span>
          <span class="mt-3 flex items-center justify-between gap-3 text-xs text-fg-muted">
            <span class="flex items-center gap-3">
              <PriorityLabel priority={request.priority} class="text-xs" />
              <span class="flex items-center gap-1.5">
                <Avatar user={request.requester} size="xs" />
                {request.requester.name.split(' ')[0]}
              </span>
            </span>
            <span>{formatRelative(request.updatedAt)}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
