---
/**
 * Request status: pipeline glyph + label. Shape and text carry the
 * meaning; the ordinal green ramp reinforces it.
 */
import type { RequestStatus as Status } from '@/types';
import { REQUEST_STATUS_META } from '@/lib/meta';
import { cn } from '@/lib/utils';
import RequestStatusIcon from './RequestStatusIcon.astro';

interface Props {
  status: Status;
  /** "chip" adds a bordered container (headers, menu triggers) */
  variant?: 'plain' | 'chip';
  class?: string;
}

const { status, variant = 'plain', class: className } = Astro.props;
---

<span
  class={cn(
    'inline-flex items-center gap-1.5 text-[13px] whitespace-nowrap text-fg',
    variant === 'chip' && 'h-7 rounded-md border border-line bg-surface px-2 shadow-xs',
    className,
  )}
>
  <RequestStatusIcon status={status} />
  {REQUEST_STATUS_META[status].label}
</span>
