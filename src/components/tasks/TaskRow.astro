---
/**
 * One task. Two layouts:
 *   - "full"    (Tasks page, project pages): checkbox, title, project,
 *               priority, assignee menu, due date, status menu, details
 *   - "compact" (Overview): checkbox, title, priority, due date
 *
 * The row's `data-status` drives its appearance (and the matching
 * [data-status-label] is shown), so src/scripts/tasks.ts can update a row
 * optimistically after PATCH /api/tasks/:id without re-rendering it.
 */
import type { Profile, TaskWithRelations } from '@/types';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import FolderKanban from '@lucide/astro/icons/folder-kanban';
import Trash from '@lucide/astro/icons/trash';
import UserRound from '@lucide/astro/icons/user-round';
import UserRoundPlus from '@lucide/astro/icons/user-round-plus';
import Avatar from '@/components/ui/Avatar.astro';
import Menu from '@/components/ui/Menu.astro';
import MenuItem from '@/components/ui/MenuItem.astro';
import MenuLabel from '@/components/ui/MenuLabel.astro';
import MenuSeparator from '@/components/ui/MenuSeparator.astro';
import PriorityLabel from '@/components/requests/PriorityLabel.astro';
import TaskStatusIcon from './TaskStatusIcon.astro';
import TaskStatusLabel from './TaskStatusLabel.astro';
import { describeDue } from '@/lib/dates';
import { PRIORITY_META, TASK_STATUSES, TASK_STATUS_META } from '@/lib/meta';
import { cn } from '@/lib/utils';

interface Props {
  task: TaskWithRelations;
  timeZone: string;
  variant?: 'full' | 'compact';
  /** People who can be assigned (full layout) */
  people?: Profile[];
  /** Hide the project column (on a project's own page) */
  hideProject?: boolean;
  /** Initially filtered out by the list search */
  hidden?: boolean;
}

const { task, timeZone, variant = 'full', people = [], hideProject = false, hidden = false } = Astro.props;
const done = task.status === 'completed';
const due = describeDue(task.due_date, timeZone, done);
const dueClass = {
  overdue: 'text-danger-ink',
  soon: 'text-warning-ink',
  normal: 'text-fg-muted',
  done: 'text-fg-subtle',
}[due.tone];
const statusMenuId = `task-status-${task.id}`;
const assigneeMenuId = `task-assignee-${task.id}`;
const detailsId = `task-details-${task.id}`;
const searchText = [task.title, task.description, task.project.name, task.assignee?.full_name, PRIORITY_META[task.priority].label]
  .filter(Boolean)
  .join(' ');
---

<li
  id={variant === 'full' ? `task-${task.id}` : undefined}
  data-highlight
  data-task-row={task.id}
  data-status={task.status}
  data-priority={task.priority}
  data-filter-item
  data-filter-text={searchText}
  hidden={hidden}
  class="group/task border-b border-line last:border-b-0"
>
  <div class={cn('flex items-center gap-3', variant === 'full' ? 'min-h-12 px-4 py-2.5 sm:px-5' : 'min-h-11 py-2')}>
    <label class="relative -m-1.5 flex shrink-0 p-1.5">
      <input
        type="checkbox"
        data-task-toggle
        checked={done}
        class="peer absolute inset-0 z-10 cursor-pointer opacity-0"
        aria-label={`Mark “${task.title}” as complete`}
      />
      <span
        class="flex size-[18px] items-center justify-center rounded-[5px] border border-line-strong bg-surface transition-colors duration-150 peer-checked:border-accent peer-checked:bg-accent peer-hover:border-accent peer-focus-visible:ring-3 peer-focus-visible:ring-ring pointer-coarse:size-6"
        aria-hidden="true"
      >
      </span>
      <Check
        class="pointer-events-none absolute top-1/2 left-1/2 size-3 -translate-1/2 scale-75 text-accent-fg opacity-0 transition-[opacity,transform] duration-150 peer-checked:scale-100 peer-checked:opacity-100"
        stroke-width={3}
        aria-hidden="true"
      />
    </label>

    <div class="min-w-0 flex-1">
      <p
        class="truncate text-[13px] font-medium text-fg transition-colors group-data-[status=completed]/task:text-fg-subtle group-data-[status=completed]/task:line-through"
      >
        {task.title}
      </p>
      {
        (variant === 'compact' || !hideProject) && (
          <p class={cn('mt-0.5 truncate text-xs text-fg-subtle', variant === 'full' && 'lg:hidden')}>{task.project.name}</p>
        )
      }
      {
        variant === 'full' && (
          <div class="mt-1 flex items-center gap-3 text-xs md:hidden">
            <PriorityLabel priority={task.priority} class="text-xs" />
            <span class={dueClass}>{due.label}</span>
          </div>
        )
      }
    </div>

    {
      variant === 'full' && !hideProject && (
        <span class="hidden w-40 shrink-0 truncate lg:block">
          <a
            href={`/projects/${task.project.id}`}
            class="inline-flex max-w-full items-center gap-1.5 truncate text-xs text-fg-muted hover:text-fg"
          >
            <FolderKanban class="size-3.5 shrink-0 text-fg-subtle" aria-hidden="true" />
            <span class="truncate">{task.project.name}</span>
          </a>
        </span>
      )
    }

    <PriorityLabel
      priority={task.priority}
      iconOnly={variant === 'compact'}
      class={cn('shrink-0', variant === 'full' && 'w-20 max-md:hidden')}
    />

    {
      variant === 'full' && (
        <>
          <button
            type="button"
            popovertarget={assigneeMenuId}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label={`Assignee: ${task.assignee?.full_name ?? 'nobody'}. Change assignee`}
            title={task.assignee?.full_name ?? 'Unassigned'}
            class="-m-1 shrink-0 rounded-full p-1 transition-colors hover:bg-subtle max-sm:hidden"
          >
            <span data-task-assignee-avatar class="flex">
              {task.assignee ? (
                <Avatar user={task.assignee} />
              ) : (
                <span class="flex size-6 items-center justify-center rounded-full border border-dashed border-line-strong text-fg-subtle">
                  <UserRoundPlus class="size-3" aria-hidden="true" />
                </span>
              )}
            </span>
          </button>
          <Menu id={assigneeMenuId} label="Assign task" class="w-60">
            <MenuLabel>Assign to</MenuLabel>
            {people.map((person) => (
              <MenuItem
                data-task-assignee={person.id}
                data-task-id={task.id}
                data-name={person.full_name}
                checked={person.id === task.assignee_id}
              >
                <Avatar slot="icon" user={person} />
                {person.full_name}
              </MenuItem>
            ))}
            <MenuSeparator />
            <MenuItem data-task-assignee="" data-task-id={task.id} checked={!task.assignee_id}>
              <UserRound slot="icon" aria-hidden="true" />
              Unassigned
            </MenuItem>
          </Menu>
        </>
      )
    }

    <span class={cn('shrink-0 text-right text-xs whitespace-nowrap', dueClass, variant === 'full' ? 'hidden w-28 md:block' : 'w-24')}>
      {task.due_date ? <time datetime={task.due_date}>{due.label}</time> : <span class="text-fg-subtle">—</span>}
    </span>

    {
      variant === 'full' && (
        <>
          <button
            type="button"
            popovertarget={statusMenuId}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label={`Change status of “${task.title}”`}
            class="hidden h-7 w-32 shrink-0 items-center justify-between gap-1 rounded-md px-2 text-fg transition-colors hover:bg-subtle sm:inline-flex"
          >
            {TASK_STATUSES.map((status) => (
              <span data-status-label={status} hidden={status !== task.status} class="inline-flex">
                <TaskStatusLabel status={status} />
              </span>
            ))}
            <ChevronDown class="size-3.5 text-fg-subtle" aria-hidden="true" />
          </button>
          <Menu id={statusMenuId} label="Task status" class="min-w-44">
            <MenuLabel>Status</MenuLabel>
            {TASK_STATUSES.map((status) => (
              <MenuItem data-task-status={status} data-task-id={task.id} checked={task.status === status}>
                <TaskStatusIcon slot="icon" status={status} />
                {TASK_STATUS_META[status].label}
              </MenuItem>
            ))}
          </Menu>
          <button
            type="button"
            data-task-expand
            aria-expanded="false"
            aria-controls={detailsId}
            aria-label={`Show details for “${task.title}”`}
            class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-fg-subtle transition-colors hover:bg-subtle hover:text-fg aria-expanded:rotate-180 pointer-coarse:size-9"
          >
            <ChevronDown class="size-4" aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>

  {
    variant === 'full' && (
      <div id={detailsId} hidden class="px-4 pb-4 pl-[3.25rem] sm:px-5 sm:pl-[3.5rem]">
        <div class="rounded-lg border border-line bg-subtle/60 p-3.5">
          <p class={cn('text-[13px] leading-relaxed', task.description ? 'text-fg' : 'text-fg-subtle')}>
            {task.description ?? 'No description.'}
          </p>
          <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
            <dl class="flex flex-wrap gap-x-6 gap-y-2 text-xs">
              <div class="flex items-center gap-1.5">
                <dt class="text-fg-subtle">Assignee</dt>
                <dd class="font-medium text-fg" data-task-assignee-name>
                  {task.assignee?.full_name ?? 'Unassigned'}
                </dd>
              </div>
              <div class="flex items-center gap-1.5 sm:hidden">
                <dt class="text-fg-subtle">Status</dt>
                <dd class="font-medium text-fg">
                  {TASK_STATUSES.map((status) => (
                    <span data-status-label={status} hidden={status !== task.status}>
                      {TASK_STATUS_META[status].label}
                    </span>
                  ))}
                </dd>
              </div>
              <div class="flex items-center gap-1.5">
                <dt class="text-fg-subtle">Project</dt>
                <dd>
                  <a href={`/projects/${task.project.id}`} class="font-medium text-accent-ink hover:underline">
                    {task.project.name}
                  </a>
                </dd>
              </div>
            </dl>
            <button
              type="button"
              data-task-delete={task.id}
              data-title={task.title}
              class="inline-flex h-7 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-danger-ink transition-colors hover:bg-danger-soft"
            >
              <Trash class="size-3.5" aria-hidden="true" />
              Delete task
            </button>
          </div>
        </div>
      </div>
    )
  }
</li>
