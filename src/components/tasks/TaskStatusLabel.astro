---
import type { TaskStatus } from '@/types';
import { TASK_STATUS_META } from '@/lib/meta';
import { cn } from '@/lib/utils';
import TaskStatusIcon from './TaskStatusIcon.astro';

interface Props {
  status: TaskStatus;
  class?: string;
}

const { status, class: className } = Astro.props;
---

<span class={cn('inline-flex items-center gap-1.5 text-[13px] whitespace-nowrap', className)}>
  <TaskStatusIcon status={status} />
  {TASK_STATUS_META[status].label}
</span>
