---
import type { ProjectWithRelations } from '@/types';
import Clock from '@lucide/astro/icons/clock';
import SquareCheckBig from '@lucide/astro/icons/square-check-big';
import Avatar from '@/components/ui/Avatar.astro';
import ProgressBar from '@/components/ui/ProgressBar.astro';
import ProjectStatusBadge from './ProjectStatusBadge.astro';
import { formatDateTime, formatRelative } from '@/lib/dates';

interface Props {
  project: ProjectWithRelations;
  timeZone: string;
}

const { project, timeZone } = Astro.props;
---

<article
  class="group relative flex flex-col rounded-card border border-line bg-surface p-5 shadow-card transition-[border-color,box-shadow] duration-150 hover:border-line-strong"
>
  <div class="flex items-start justify-between gap-3">
    <h2 class="min-w-0 text-[15px] font-semibold tracking-tight text-fg">
      <a
        href={`/projects/${project.id}`}
        class="outline-none after:absolute after:inset-0 after:rounded-card focus-visible:after:outline-2 focus-visible:after:outline-ring"
      >
        {project.name}
      </a>
    </h2>
    <ProjectStatusBadge status={project.status} class="shrink-0" />
  </div>

  <p class="mt-2 line-clamp-2 text-[13px] leading-relaxed text-fg-muted">{project.description}</p>

  <div class="mt-auto pt-5">
    <div class="mb-2 flex items-baseline justify-between">
      <span class="text-xs text-fg-muted">Progress</span>
      <span class="text-sm font-semibold text-fg">{project.progress}%</span>
    </div>
    <ProgressBar value={project.progress} label={`${project.name} progress`} tone={project.status === 'on_hold' ? 'warning' : 'accent'} />
  </div>

  <div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4 text-xs text-fg-muted">
    <span class="flex min-w-0 items-center gap-2">
      <Avatar user={project.owner} size="xs" />
      <span class="truncate">{project.owner.full_name}</span>
    </span>
    <span class="flex shrink-0 items-center gap-3">
      <span class="flex items-center gap-1" title={`${project.completed_task_count} of ${project.task_count} tasks completed`}>
        <SquareCheckBig class="size-3.5 text-fg-subtle" aria-hidden="true" />
        <span class="tabular">{project.completed_task_count}/{project.task_count}</span>
        <span class="sr-only">tasks completed</span>
      </span>
      <span class="flex items-center gap-1" title={`Updated ${formatDateTime(project.updated_at, timeZone)}`}>
        <Clock class="size-3.5 text-fg-subtle" aria-hidden="true" />
        <span class="sr-only">Updated</span>
        {formatRelative(project.updated_at)}
      </span>
    </span>
  </div>
</article>
