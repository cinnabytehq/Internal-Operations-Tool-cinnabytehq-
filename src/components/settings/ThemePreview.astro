---
/**
 * Miniature app window rendered in a specific theme (the tokens are
 * scoped by data-theme), used by the Appearance settings.
 */
interface Props {
  theme: 'light' | 'dark';
}

const { theme } = Astro.props;
---

<div data-theme={theme} class="flex h-full w-full bg-canvas" aria-hidden="true">
  <div class="flex w-1/4 flex-col gap-1.5 border-r border-line p-2">
    <span class="size-2.5 rounded-[3px] bg-accent"></span>
    <span class="mt-1 h-1.5 w-4/5 rounded-full bg-muted"></span>
    <span class="h-1.5 w-3/5 rounded-full bg-muted"></span>
    <span class="h-1.5 w-2/3 rounded-full bg-muted"></span>
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-2">
    <span class="h-2 w-1/2 rounded-full bg-fg/80"></span>
    <div class="mt-1 grid grid-cols-2 gap-1.5">
      <span class="h-5 rounded-[3px] border border-line bg-surface"></span>
      <span class="h-5 rounded-[3px] border border-line bg-surface"></span>
    </div>
    <span class="flex-1 rounded-[3px] border border-line bg-surface p-1.5">
      <span class="block h-1 w-3/4 rounded-full bg-accent/70"></span>
    </span>
  </div>
</div>
