---
/**
 * Link-based tabs for filtered views (?view=…). Links keep the state in the
 * URL, so filtered views can be shared and survive reloads. Styling follows
 * `aria-current`, so a script can switch tabs without re-rendering.
 */
import { cn } from '@/lib/utils';
import type { TabItem } from './types';

interface Props {
  items: TabItem[];
  label: string;
  class?: string;
}

const { items, label, class: className } = Astro.props;
---

<nav aria-label={label} class={cn('-mx-1 overflow-x-auto no-scrollbar', className)}>
  <ul class="flex min-w-max items-center gap-0.5 px-1">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            data-tab={item.countKey}
            class="group relative inline-flex h-8 items-center gap-1.5 rounded-md px-2.5 text-[13px] font-medium text-fg-muted transition-colors duration-150 hover:bg-subtle hover:text-fg aria-[current=page]:bg-surface aria-[current=page]:text-fg aria-[current=page]:shadow-xs aria-[current=page]:ring-1 aria-[current=page]:ring-line pointer-coarse:h-10"
          >
            {item.label}
            {(item.count !== undefined || item.countKey) && (
              <span
                data-count={item.countKey}
                class="tabular min-w-5 rounded bg-muted px-1 text-center text-[11px] leading-[18px] text-fg-muted empty:hidden group-aria-[current=page]:bg-accent-soft group-aria-[current=page]:text-accent-ink"
              >
                {item.count}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
