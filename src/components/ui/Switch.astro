---
/**
 * Toggle switch: a real checkbox (keyboard + screen reader friendly) with
 * a custom visual.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'class'> {
  id: string;
  label: string;
  description?: string;
}

const { id, label, description, ...rest } = Astro.props;
---

<div class="flex items-start justify-between gap-6 py-3.5">
  <div class="min-w-0">
    <label for={id} class="text-sm font-medium text-fg">{label}</label>
    {
      description && (
        <p id={`${id}-description`} class="mt-0.5 text-[13px] text-fg-muted">
          {description}
        </p>
      )
    }
  </div>
  <span class="relative inline-flex shrink-0">
    <input
      id={id}
      type="checkbox"
      role="switch"
      class="peer absolute inset-0 z-10 size-full cursor-pointer opacity-0"
      aria-describedby={description ? `${id}-description` : undefined}
      {...rest}
    />
    <span
      aria-hidden="true"
      class="h-5 w-9 rounded-full bg-muted ring-1 ring-line-strong transition-colors duration-150 ring-inset peer-checked:bg-accent peer-checked:ring-transparent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring peer-disabled:opacity-50"
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute top-0.5 left-0.5 size-4 rounded-full bg-white shadow-xs ring-1 ring-black/5 transition-transform duration-150 peer-checked:translate-x-4"
    ></span>
  </span>
</div>
