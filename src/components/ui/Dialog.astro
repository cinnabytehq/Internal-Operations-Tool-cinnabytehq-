---
/**
 * Modal dialog built on the native <dialog> element (focus trap, Escape,
 * inert background for free). Open it with a button that has
 * `data-dialog-open={id}`; close with `data-dialog-close`.
 * On phones it becomes a bottom sheet.
 * Slots: default (body), "footer".
 */
import X from '@lucide/astro/icons/x';
import { cn } from '@/lib/utils';

interface Props {
  id: string;
  title: string;
  description?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { id, title, description, size = 'md', class: className } = Astro.props;

const widths = { sm: 'md:max-w-sm', md: 'md:max-w-lg', lg: 'md:max-w-2xl' };
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  aria-describedby={description ? `${id}-description` : undefined}
  class={cn(
    'dialog-panel border border-line bg-elevated p-0 text-fg shadow-dialog',
    'inset-x-0 bottom-0 mx-auto mt-auto mb-0 max-h-[92dvh] w-full rounded-t-2xl',
    'md:m-auto md:w-[calc(100%-2rem)] md:rounded-xl',
    widths[size],
    className,
  )}
>
  <div class="flex max-h-[inherit] flex-col">
    <header class="flex items-start justify-between gap-4 px-5 pt-5 pb-1">
      <div class="min-w-0">
        <h2 id={`${id}-title`} class="text-base font-semibold tracking-tight">{title}</h2>
        {
          description && (
            <p id={`${id}-description`} class="mt-1 text-[13px] text-fg-muted">
              {description}
            </p>
          )
        }
      </div>
      <button
        type="button"
        data-dialog-close
        class="-mt-1 -mr-2 inline-flex size-8 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-subtle hover:text-fg"
        aria-label="Close"
      >
        <X class="size-4" aria-hidden="true" />
      </button>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto px-5 pt-3 pb-5">
      <slot />
    </div>
    {
      Astro.slots.has('footer') && (
        <footer class="flex flex-col-reverse gap-2 border-t border-line bg-subtle/60 px-5 py-3 sm:flex-row sm:justify-end md:rounded-b-xl">
          <slot name="footer" />
        </footer>
      )
    }
  </div>
</dialog>
