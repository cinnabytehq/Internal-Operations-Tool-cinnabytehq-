---
/**
 * Setup guide. The middleware shows this page (at the requested URL) until
 * Supabase is configured, migrated and seeded, so a fresh clone explains
 * what's missing instead of crashing. Data comes from GET /api/health.
 *
 * Deliberately built on BaseLayout, not AppLayout: the app shell needs a
 * working API and a signed-in (dev) user.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CircleCheck from '@lucide/astro/icons/circle-check';
import CircleDashed from '@lucide/astro/icons/circle-dashed';
import CircleX from '@lucide/astro/icons/circle-x';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/layout/Logo.astro';
import Button from '@/components/ui/Button.astro';
import { serverApi } from '@/lib/api/server';
import type { HealthReport } from '@/types';

let report: HealthReport;
try {
  report = await serverApi(Astro).getHealth();
} catch {
  report = {
    ok: false,
    checks: {
      env: { supabase_url: false, service_role_key: false, anon_key: false },
      database: { ok: false, message: "The setup check couldn't run. Is the server reachable?" },
      dev_user: { ok: false, email: '', message: 'Waiting for the database.' },
    },
  };
}
Astro.response.status = report.ok ? 200 : 503;
// Re-rendered at the URL the person asked for, so "Check again" is a reload.
const cameFrom = Astro.url.pathname === '/setup' ? '/dashboard' : Astro.url.pathname;

const { env, database, dev_user: devUser } = report.checks;
const envOk = env.supabase_url && env.service_role_key;
type State = 'ok' | 'error' | 'waiting';
const steps: Array<{ id: string; title: string; state: State; message: string }> = [
  {
    id: 'env',
    title: 'Environment variables',
    state: envOk ? 'ok' : 'error',
    message: envOk ? 'Supabase URL and service-role key found.' : 'Add your Supabase project keys to .env.',
  },
  {
    id: 'database',
    title: 'Database schema',
    state: database.ok ? 'ok' : envOk ? 'error' : 'waiting',
    message: database.ok || envOk ? database.message : 'Waiting for the environment variables.',
  },
  {
    id: 'user',
    title: 'Development user',
    state: devUser.ok ? 'ok' : database.ok ? 'error' : 'waiting',
    message: devUser.message,
  },
];
const variables = [
  { name: 'PUBLIC_SUPABASE_URL', set: env.supabase_url, note: 'Project Settings → API → Project URL' },
  { name: 'SUPABASE_SERVICE_ROLE_KEY', set: env.service_role_key, note: 'Project Settings → API keys → service_role (secret, server only)' },
  { name: 'PUBLIC_SUPABASE_ANON_KEY', set: env.anon_key, note: 'Optional for now — used once sign-in ships' },
];
const code = 'block overflow-x-auto rounded-lg border border-line bg-subtle px-3 py-2.5 font-mono text-xs leading-relaxed text-fg';
const inline = 'rounded bg-subtle px-1 py-0.5 font-mono text-[12px] text-fg';
---

<BaseLayout title={report.ok ? 'Setup complete' : 'Finish setup'}>
  <main class="mx-auto flex min-h-dvh w-full max-w-2xl flex-col px-4 py-10 sm:py-16">
    <Logo href="/setup" />

    <h1 class="mt-10 text-2xl font-semibold tracking-tight text-fg">
      {report.ok ? 'CinnabyteHQ is ready' : 'Connect CinnabyteHQ to Supabase'}
    </h1>
    <p class="mt-2 text-sm leading-relaxed text-fg-muted">
      {
        report.ok
          ? 'Supabase is configured, the schema is in place and the development user exists.'
          : 'The app stores everything in PostgreSQL through Supabase. A few things still need setting up — this page updates as you go.'
      }
    </p>

    <ol class="mt-8 overflow-hidden rounded-card border border-line bg-surface shadow-card" aria-label="Setup checklist">
      {
        steps.map((step) => (
          <li class="flex gap-3 border-b border-line px-5 py-4 last:border-b-0" data-setup-step={step.id} data-state={step.state}>
            {step.state === 'ok' && <CircleCheck class="mt-0.5 size-4 shrink-0 text-success-ink" aria-hidden="true" />}
            {step.state === 'error' && <CircleX class="mt-0.5 size-4 shrink-0 text-danger-ink" aria-hidden="true" />}
            {step.state === 'waiting' && <CircleDashed class="mt-0.5 size-4 shrink-0 text-fg-subtle" aria-hidden="true" />}
            <div class="min-w-0">
              <p class="text-[13px] font-medium text-fg">
                {step.title}
                <span class="sr-only">: {step.state === 'ok' ? 'done' : step.state === 'error' ? 'needs attention' : 'waiting'}</span>
              </p>
              <p class="mt-0.5 text-[13px] break-words text-fg-muted">{step.message}</p>
            </div>
          </li>
        ))
      }
    </ol>

    {
      !envOk && (
        <section class="mt-8" aria-labelledby="env-heading">
          <h2 id="env-heading" class="text-sm font-semibold text-fg">
            1. Add your Supabase keys
          </h2>
          <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">
            Copy <code class={inline}>.env.example</code> to <code class={inline}>.env</code> and fill in the values from your
            Supabase dashboard, then restart the dev server.
          </p>
          <pre class={`${code} mt-3`}>cp .env.example .env</pre>
          <ul class="mt-3 divide-y divide-line rounded-lg border border-line bg-surface">
            {variables.map((variable) => (
              <li class="flex items-start gap-3 px-3.5 py-2.5">
                {variable.set ? (
                  <CircleCheck class="mt-0.5 size-3.5 shrink-0 text-success-ink" aria-label="Set" />
                ) : (
                  <CircleDashed class="mt-0.5 size-3.5 shrink-0 text-fg-subtle" aria-label="Not set" />
                )}
                <div class="min-w-0">
                  <p class="font-mono text-xs break-all text-fg">{variable.name}</p>
                  <p class="mt-0.5 text-xs text-fg-muted">{variable.note}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-3 flex gap-2 rounded-lg border border-warning-ink/20 bg-warning-soft px-3.5 py-2.5 text-xs leading-relaxed text-warning-ink">
            <TriangleAlert class="mt-px size-3.5 shrink-0" aria-hidden="true" />
            <span>
              The service-role key bypasses Row Level Security. It is only read on the server — never prefix it with{' '}
              <code class="font-mono">PUBLIC_</code>, and never commit <code class="font-mono">.env</code>.
            </span>
          </p>
        </section>
      )
    }

    {
      envOk && !database.ok && (
        <section class="mt-8" aria-labelledby="db-heading">
          <h2 id="db-heading" class="text-sm font-semibold text-fg">
            2. Create the tables and sample data
          </h2>
          <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">
            In the Supabase dashboard open <strong class="font-medium text-fg">SQL Editor</strong>, paste and run each file in
            order:
          </p>
          <pre class={`${code} mt-3`}>supabase/migrations/001_initial_schema.sql
supabase/seed.sql</pre>
          <p class="mt-3 text-[13px] leading-relaxed text-fg-muted">
            Using the Supabase CLI instead? <code class={inline}>supabase db reset</code> runs both. If the tables already exist,
            double-check that <code class={inline}>PUBLIC_SUPABASE_URL</code> points at the right project.
          </p>
        </section>
      )
    }

    {
      database.ok && !devUser.ok && (
        <section class="mt-8" aria-labelledby="user-heading">
          <h2 id="user-heading" class="text-sm font-semibold text-fg">
            3. Pick a development user
          </h2>
          <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">
            Until sign-in is built, every request acts as the profile whose email matches{' '}
            <code class={inline}>DEV_USER_EMAIL</code>
            {devUser.email && (
              <>
                {' '}(currently <code class={inline}>{devUser.email}</code>)
              </>
            )}. Run <code class={inline}>supabase/seed.sql</code>, or set <code class={inline}>DEV_USER_EMAIL</code> to the
            email of a row in <code class={inline}>profiles</code> and restart the server.
          </p>
        </section>
      )
    }

    <div class="mt-8 flex flex-wrap items-center gap-2">
      {
        report.ok ? (
          <Button href={cameFrom} variant="primary">
            Open CinnabyteHQ
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
        ) : (
          <Button href={Astro.url.pathname} variant="primary">
            <RotateCcw class="size-3.5" aria-hidden="true" />
            Check again
          </Button>
        )
      }
      <Button href="/api/health" variant="ghost">View raw health check</Button>
    </div>

    <p class="mt-auto pt-12 text-xs leading-relaxed text-fg-subtle">
      Development build: there is no sign-in yet, so anyone who can reach this server acts as the development user. See{' '}
      <code class="font-mono">README.md</code> → “Authentication” before deploying anywhere public.
    </p>
  </main>
</BaseLayout>
