---
/**
 * Requests — the core workflow.
 *
 * The list is loaded in the browser from GET /api/requests
 * (src/scripts/requestsPage.ts), so switching views, filtering by status or
 * priority and searching all happen without a page reload. The state lives
 * in the URL (?view=&status=&priority=&q=), so any view can be shared.
 */
import Plus from '@lucide/astro/icons/plus';
import X from '@lucide/astro/icons/x';
import AppLayout from '@/layouts/AppLayout.astro';
import Button from '@/components/ui/Button.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SearchInput from '@/components/ui/SearchInput.astro';
import Select from '@/components/ui/Select.astro';
import Tabs from '@/components/ui/Tabs.astro';
import RequestList from '@/components/requests/RequestList.astro';
import {
  PRIORITIES,
  PRIORITY_META,
  REQUEST_STATUSES,
  REQUEST_STATUS_META,
  REQUEST_VIEWS,
  isPriority,
  isRequestStatus,
  isRequestView,
} from '@/lib/meta';

const params = Astro.url.searchParams;
const view = isRequestView(params.get('view')) ? params.get('view')! : 'all';
const status = isRequestStatus(params.get('status')) ? params.get('status')! : '';
const priority = isPriority(params.get('priority')) ? params.get('priority')! : '';
const q = params.get('q') ?? '';

const tabs = REQUEST_VIEWS.map((item) => ({
  label: item.label,
  href: item.id === 'all' ? '/requests' : `/requests?view=${item.id}`,
  active: item.id === view,
  countKey: item.id,
}));
---

<AppLayout title="Requests">
  <PageHeader title="Requests" description="Track and manage internal requests across the workspace.">
    <Button slot="actions" variant="primary" data-dialog-open="create-request" class="max-sm:w-full">
      <Plus class="size-4" aria-hidden="true" />
      New request
    </Button>
  </PageHeader>

  <div data-requests-app class="mt-6">
    <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
      <Tabs items={tabs} label="Request views" />
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <div class="grid grid-cols-2 gap-2 sm:flex">
          <Select name="status" aria-label="Filter by status" data-request-filter class="sm:w-40">
            <option value="">All statuses</option>
            {REQUEST_STATUSES.map((value) => <option value={value} selected={value === status}>{REQUEST_STATUS_META[value].label}</option>)}
          </Select>
          <Select name="priority" aria-label="Filter by priority" data-request-filter class="sm:w-36">
            <option value="">All priorities</option>
            {PRIORITIES.map((value) => <option value={value} selected={value === priority}>{PRIORITY_META[value].label}</option>)}
          </Select>
        </div>
        <SearchInput label="Search requests" placeholder="Search requests…" value={q} remote class="sm:w-64" />
        <Button variant="ghost" size="sm" data-clear-filters hidden={!status && !priority && !q} class="self-start sm:self-auto">
          <X class="size-3.5" aria-hidden="true" />
          Clear
        </Button>
      </div>
    </div>

    <div class="mt-4">
      <RequestList />
    </div>
  </div>
</AppLayout>

<script>
  import '@/scripts/requestsPage';
</script>
