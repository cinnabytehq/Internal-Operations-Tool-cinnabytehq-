# ─────────────────────────────────────────────────────────────
# CinnabyteHQ environment
#
# Copy this file to `.env` and fill in the values from your Supabase
# project: Dashboard → Project Settings → API (URL) and → API keys.
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit it. Everything below is read on the
# server only, at runtime; restart the server after changing it.
# If a required value is missing, every page shows the /setup screen and
# the API answers 503 with a message naming what to configure.
# ─────────────────────────────────────────────────────────────

# Required. Your project URL, e.g. https://abcdefghijklm.supabase.co
PUBLIC_SUPABASE_URL=

# Optional today. The public "anon" key. Row Level Security blocks it from
# all data at the moment; it is reserved for Supabase Auth (next phase).
PUBLIC_SUPABASE_ANON_KEY=

# Required. SECRET — the "service_role" key bypasses Row Level Security.
# Used only by the server-side service layer (src/lib/supabase.ts).
# Never expose it to the browser, never prefix it with PUBLIC_, and never
# paste it into client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# DEVELOPMENT ONLY — there is no sign-in yet. Every request acts as the
# profile with this email. Defaults to the seeded admin, Alex Johnson.
# This is not security: do not deploy this build publicly.
DEV_USER_EMAIL=alex.johnson@cinnabyte.io

# Optional. Where server-rendered pages call the REST API. Defaults to the
# incoming request's origin; set it when running behind a proxy, e.g.
# INTERNAL_API_URL=http://127.0.0.1:4321
INTERNAL_API_URL=
